FROM node:24-alpine
WORKDIR /workspace
ENV NODE_ENV=production
COPY --chown=node:node packages ./packages
COPY --chown=node:node replica/hnsw.js replica/quantize.js ./replica/
COPY --chown=node:node tools/reality-harness.js ./tools/reality-harness.js
RUN mkdir -p /workspace/web && chown -R node:node /workspace
USER node
CMD ["node", "tools/reality-harness.js"]
